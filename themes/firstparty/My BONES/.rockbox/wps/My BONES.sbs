#
#__My BONES
#__by__CHUCK_LARDO
#__licence__CC-BY-SA 4.0
#__version__1.1
#__2024
#__target resolution 320x240
#__tested on iPod Classic (6th Gen) and HiFi Walker H2
#
#__SBS File
#
#__Status Bar Off
%wd
#
#__Title Bar Off
%?Lt<|>
#
#__Preload Fonts
%Fl(2,15-ProFont.fnt)
%Fl(3,22-ProFont.fnt)
#
#__Preload Images
%xl(X,bg_skull.bmp,0,0)
#
#__UI Viewport (height 182 = 7 lines at 26px each, bottom margin = 30px)
%Vi(-,30,28,260,182,3)%Vf(-)%Vb(-)
#
#__Hold indicator (positioned in top margin, above UI viewport)
%V(30,8,-,-,2)
%?mh<HOLD|>
#
#
#__USB screen
%?if(%cs, =, 21)<%Vd(usbScreen)>
#
#__Clear Screen
%Vl(usbScreen,0,0,320,240,-)
#
#__USB Text
%Vl(usbScreen,30,30,260,-,3)
%acUSB%Vs(invert)
#
%Vl(usbScreen,30,195,260,-,2)
%ac! EJECT BEFORE DISCONNECTING !
#
#__Skull
%Vl(usbScreen,30,55,260,135,-)
%xd(X)
#
